# Solo si el backend está en otro servidor; por defecto usa /api y el proxy de Vite.
VITE_API_URL=/api

# Rutas del portal del usuario Proveedor: completar SOLO desde el último backend verificado.
# Estos valores vacíos deshabilitan por seguridad la consulta de órdenes.
VITE_PROVEEDOR_PERFIL_RUTA=
VITE_PROVEEDOR_ORDENES_RUTA=
VITE_PROVEEDOR_DETALLE_RUTA=
VITE_PROVEEDOR_CONFIRMAR_RUTA=
VITE_PROVEEDOR_CONFIRMAR_METODO=
